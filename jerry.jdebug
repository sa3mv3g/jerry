/*********************************************************************
*
*       AfterTargetConnect
*
* Function description
*   Event handler routine. Optional.
*   Reads and prints key option bytes to the Ozone log for verification.
*
**********************************************************************
*/
void AfterTargetConnect (void) {
  unsigned int nsbootadd_raw;
  unsigned int nsbootadd_addr;
  unsigned int secbootadd_raw;
  unsigned int secbootadd_addr;
  unsigned int secwm1_end;
  unsigned int tzen;
  unsigned int edata1_en;
  unsigned int edata1_strt;
  unsigned int swap_bank;

  // Read FLASH_NSBOOTR_CUR (offset 0x080 from FLASH base 0x40022000)
  // NSBOOTADD[23:0] = bits[31:8], decoded address = NSBOOTADD << 8
  nsbootadd_raw  = (Target.ReadU32(0x40022080) >> 8) & 0xFFFFFF;
  nsbootadd_addr = nsbootadd_raw << 8;

  // Read FLASH_SECBOOTR_CUR (offset 0x088)
  secbootadd_raw  = (Target.ReadU32(0x40022088) >> 8) & 0xFFFFFF;
  secbootadd_addr = secbootadd_raw << 8;

  // Read FLASH_SECWM1R_CUR (offset 0x0E0): SECWM1_END = bits[22:16]
  secwm1_end = (Target.ReadU32(0x400220E0) >> 16) & 0x7F;

  // Read FLASH_OPTSR2_CUR (offset 0x070): TZEN = bits[31:24]
  tzen = (Target.ReadU32(0x40022070) >> 24) & 0xFF;

  // Read FLASH_EDATA1R_CUR (offset 0x0F0): EDATA1_EN = bit15, EDATA1_STRT = bits[2:0]
  edata1_en   = (Target.ReadU32(0x400220F0) >> 15) & 0x1;
  edata1_strt = Target.ReadU32(0x400220F0) & 0x7;

  // Read FLASH_OPTSR_CUR (offset 0x050): SWAP_BANK = bit31
  swap_bank = (Target.ReadU32(0x40022050) >> 31) & 0x1;

  JLINK.SYS_Report("=== Option Bytes ===");
  JLINK.SYS_Report1("  TZEN         = 0x", tzen);
  JLINK.SYS_Report1("  NSBOOTADD    = 0x", nsbootadd_addr);
  JLINK.SYS_Report1("  SECBOOTADD   = 0x", secbootadd_addr);
  JLINK.SYS_Report1("  SECWM1_END   = sector ", secwm1_end);
  JLINK.SYS_Report1("  EDATA1_EN    = ", edata1_en);
  JLINK.SYS_Report1("  EDATA1_STRT  = ", edata1_strt);
  JLINK.SYS_Report1("  SWAP_BANK    = ", swap_bank);
  JLINK.SYS_Report("====================");

  // Warn if NSBOOTADD is wrong
  if (nsbootadd_addr != 0x08012000) {
    JLINK.SYS_Report("  WARNING: NSBOOTADD should be 0x08012000!");
    JLINK.SYS_Report("  Run: uv run tools/flash_nucleo.py --option-bytes-only --force");
  }
  if (tzen != 0xB4) {
    JLINK.SYS_Report("  WARNING: TZEN should be 0xB4 (TrustZone enabled)!");
  }
  if (edata1_en == 0) {
    JLINK.SYS_Report("  NOTE: EDATA1_EN=0 — Secure firmware will program it on first boot (triggers one reset).");
  }
}

/*********************************************************************
*
*       TargetDownload
*
* Function description
*   Replaces the default program download routine. Optional.
*
**********************************************************************
*/
void TargetDownload (void) {
  // TrustZone dual-image download:
  //   1. Erase Secure flash (0x0C000000, 72KB = sectors 0-8) to force re-flash
  //   2. Flash Secure ELF  → Bank 1 sectors 0-7  (0x0C000000, Secure alias)
  //   3. Flash NonSecure ELF → Bank 1 sectors 9-127 (0x08012000)
  //
  // Option bytes (NSBOOTADD=0x08012000, SECWM1_END=8, TZEN=0xB4) must be
  // programmed once before first use:
  //   uv run tools/flash_nucleo.py --option-bytes-only --force
  //
  // After download, AfterTargetDownload() sets PC to Secure Reset_Handler
  // so the full boot sequence runs: Secure init → SAU/GTZC → NS firmware.
  //
  // Erase is required because Target.LoadMemory() skips unchanged regions.
  // Without erase, a rebuild with minor changes may not be re-flashed.

  JLINK.SYS_Report("Erasing Secure flash (0x0C000000 - 0x0C011FFF, 72KB)...");
  Target.EraseRange(0x0C000000, 0x0C011FFF);

  JLINK.SYS_Report("Downloading Secure firmware (jerry_secure_app.elf)...");
  Target.LoadMemory("$(ProjectDir)/build/stm-Debug/application/bsp/stm/stm32h563/jerry_secure_app.elf");

  JLINK.SYS_Report("Downloading NonSecure firmware (jerry_app.elf)...");
  Target.LoadMemory("$(ProjectDir)/build/stm-Debug/application/jerry_app.elf");

  JLINK.SYS_Report("Download complete.");
}

