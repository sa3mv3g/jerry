/*********************************************************************
*
*       _SetupTarget
*
* Function description
*   Setup the target.
*   Called by AfterTargetReset() and AfterTargetDownload().
*
*   Auto-generated function. May be overridden by Ozone.
*
**********************************************************************
*/
void _SetupTarget(void) {
  unsigned int SP;
  unsigned int PC;
  // TrustZone project: Secure firmware boots first from 0x0C000000.
  // The NS firmware vector table is at 0x08012000 (NSBOOTADD).
  // We set PC to the Secure firmware Reset_Handler so the full boot
  // sequence runs: Secure init → GTZC/SAU setup → jump to NS firmware.
  // This ensures EDATA, MPU, and TrustZone are properly initialized.
  unsigned int SecureVectorTable = 0x0C000000;

  // Read initial SP from Secure vector table word 0
  SP = Target.ReadU32(SecureVectorTable);
  if (SP != 0xFFFFFFFF) {
    Target.SetReg("SP", SP);
  }
  // Read Reset_Handler from Secure vector table word 1 (clear thumb bit)
  PC = Target.ReadU32(SecureVectorTable + 4) & 0xFFFFFFFE;
  if (PC != 0xFFFFFFFF && PC != 0) {
    Target.SetReg("PC", PC);
  } else {
    Util.Error("Project script error: failed to read Secure Reset_Handler from 0x0C000004", 1);
  }
}