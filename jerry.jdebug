/*********************************************************************
*
*       OnProjectLoad
*
* Function description
*   Project load routine. Required.
*
**********************************************************************
*/
void OnProjectLoad (void) {
  //
  // Dialog-generated settings
  //
  Project.AddPathSubstitute ("/home/a0500224local/ti/workarea/mpcs/jerry", "$(ProjectDir)");
  Project.AddPathSubstitute ("/home/a0500224local/ti/workarea/mpcs/jerry", "$(ProjectDir)");
  Project.SetDevice ("STM32H563ZI");
  Project.SetHostIF ("USB", "");
  Project.SetTargetIF ("SWD");
  Project.SetTIFSpeed ("4 MHz");
  Project.AddSvdFile ("$(InstallDir)/Config/CPU/Cortex-M33F.svd");
  //
  // User settings
  //
  // Load NS application ELF (primary debug target)
  File.Open ("$(ProjectDir)/build/stm-Debug/application/jerry_app.elf");
  // Also load Secure ELF for full symbol resolution across TrustZone boundary
  // File.Open ("$(ProjectDir)/build/stm-Debug/application/bsp/stm/stm32h563/jerry_secure_app.elf");
  Project.SetOSPlugin ("FreeRTOSPlugin_Cortex-M");
}

